# ── NextAuth ───────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# ── Admin Credentials ───────────────────────────────────────────────────
# Default username: admin
ADMIN_USERNAME=admin

# Default password: ardhisoko2025
# To generate a new hash: node -e "const b=require('bcryptjs');b.hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi

# ── ImgBB Image Upload ──────────────────────────────────────────────────
# Get your free API key at: https://api.imgbb.com/
# Without this key, images are stored as base64 data URLs locally
NEXT_PUBLIC_IMGBB_API_KEY=your-imgbb-api-key-here
